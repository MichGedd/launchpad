{
  "name": "launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.x",
    "npm": "11.19.x"
  },
  "scripts": {
    "build": "react-router build",
    "check": "npm run typecheck && npm run build",
    "dev": "node --experimental-strip-types server/index.ts",
    "setup": "npm ci && npm start",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test app/engine/*.test.ts app/visualizer/*.test.ts app/components/visualizer/*.test.ts app/llm/*.test.ts app/policy/*.test.ts app/simulation/*.test.ts server/*.test.ts",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "7.18.3",
    "ai": "^7.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.37.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.3",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
